rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'elzieni2007@gmail.com';
    }

    function isOwner(resource) {
      return isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    function isNewOwner() {
      return isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // A registered organization/user may edit only its own pending
    // document and cannot change ownership or move it to an approved state.
    function isOwnerPendingUpdate(resource) {
      return isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == 'pending';
    }

    // Public collections: anyone can browse, only admin can write.
    match /jobs/{doc} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwnerPendingUpdate(resource);
      allow delete: if isAdmin() || isOwner(resource);
    }

    match /tenders/{doc} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwnerPendingUpdate(resource);
      allow delete: if isAdmin() || isOwner(resource);
    }

    match /consultants/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /suppliers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /volunteers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /jobseekers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Organization profiles are public to browse.
    // Creation and deletion are controlled by the admin.
    match /organizations/{doc} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(resource);
      allow delete: if isAdmin();
    }

    // Public submissions are allowed without registration.
    // Registered organization accounts must bind ownerUid to their own account.
    // All submissions remain in moderation until the admin approves them.
    match /pending_jobs/{doc} {
      allow create: if !isSignedIn() || isNewOwner();
      allow read: if isAdmin() || isOwner(resource);
      allow update: if isAdmin() || isOwnerPendingUpdate(resource);
      allow delete: if isAdmin() || isOwner(resource);
    }

    match /pending_tenders/{doc} {
      allow create: if !isSignedIn() || isNewOwner();
      allow read: if isAdmin() || isOwner(resource);
      allow update: if isAdmin() || isOwnerPendingUpdate(resource);
      allow delete: if isAdmin() || isOwner(resource);
    }

    // Public registration/request forms.
    // These records are not publicly readable.
    match /org_requests/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /registration_requests/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /consultations/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ===== أكاديمية تنمويين مصر =====
    // التدريبات: الكل يشوفها، والأدمن بس يضيف ويعدل
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      match /messages/{msgId} {
        allow read, write: if isAdmin();
      }
    }

    // تفضيلات الإشعارات: رقم المستند = رقم اشتراك الإشعارات نفسه (مش متوقع)
    match /push_prefs/{subId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['subId','jobs','tenders','secs','govs','platform','updatedAt'])
        && request.resource.data.subId == subId
        && subId.size() >= 8 && subId.size() <= 80
        && request.resource.data.jobs is bool
        && request.resource.data.tenders is bool
        && request.resource.data.secs is list && request.resource.data.secs.size() <= 20
        && request.resource.data.govs is list && request.resource.data.govs.size() <= 30;
      allow delete: if isAdmin();
    }

    // شهادات الأكاديمية: أي حد يقدر يتحقق منها، والأدمن بس يصدرها
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // تسجيلات التدريب: أي حد يسجل (لو التدريب مفتوح)، والأدمن بس يقرا ويعدل.
    // رقم المستند = رقم التدريب + "_" + الموبايل، فنفس الرقم مايقدرش يسجل مرتين.
    match /course_registrations/{regId} {
      allow create: if request.resource.data.keys().hasOnly(['courseId','courseTitle','name','phone','email','gov','org','jobTitle','prevTraining','heardFrom','notes','consent','pushId','status','createdAt','source'])
        && request.resource.data.courseId is string
        && regId == request.resource.data.courseId + '_' + request.resource.data.phone
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.status == 'new'
        && request.resource.data.consent == true
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.status == 'open';
      // المستخدم يقدر بس يضيف رقم الإشعارات بتاعه بعد التسجيل
      allow update: if isAdmin()
        || (resource.data.get('pushId', '') == ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pushId'])
            && request.resource.data.pushId is string
            && request.resource.data.pushId.size() < 80);
      allow read, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
